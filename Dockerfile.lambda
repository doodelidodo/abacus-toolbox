# Variante für AWS Lambda (mit AWS Lambda Web Adapter).
# Gleiche App wie im normalen Dockerfile; der Adapter übersetzt Lambda-Aufrufe
# in normale HTTP-Requests an uvicorn auf Port 8000.
# Wird von deploy-aws.ps1 gebaut (Build-Kontext = Repository-Hauptverzeichnis).
FROM python:3.12-slim

COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:1.1.0 /lambda-adapter /opt/extensions/lambda-adapter

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    CONFIG_PATH=/config/xml_to_xlsx_config.json \
    AWS_LWA_PORT=8000 \
    AWS_LWA_READINESS_CHECK_PATH=/health \
    MAX_UPLOAD_MB=5

WORKDIR /app

COPY requirements.txt .
RUN pip install -r requirements.txt

COPY converter/xml_to_xlsx.py /app/xml_to_xlsx.py
COPY converter/xml_to_xlsx_config.json /config/xml_to_xlsx_config.json
COPY app/ /app/

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
